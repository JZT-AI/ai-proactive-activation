 as="geometry" /></mxCell><mxCell id="9" value="注册已有规则&lt;br&gt;提供名称、渠道与分类" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef4ff;strokeColor=#a8bde8;fontColor=#24364c;fontSize=14;spacing=8;" vertex="1" parent="7"><mxGeometry x="202" y="58" width="160" height="72" as="geometry" /></mxCell><mxCell id="10" value="读取当前城市&lt;br&gt;已注册任务及实际状态" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef4ff;strokeColor=#a8bde8;fontColor=#24364c;fontSize=14;spacing=8;" vertex="1" parent="5"><mxGeometry x="412" y="58" width="160" height="72" as="geometry" /></mxCell><mxCell id="11" value="查看、搜索或筛选&lt;br&gt;普通成员仅查看" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef4ff;strokeColor=#a8bde8;fontColor=#24364c;fontSize=14;spacing=8;" vertex="1" parent="3"><mxGeometry x="622" y="58" width="160" height="72" as="geometry" /></mxCell><mxCell id="12" value="管理员开启 / 关闭&lt;br&gt;关闭时确认城市与任务" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef4ff;strokeColor=#a8bde8;fontColor=#24364c;fontSize=14;spacing=8;" vertex="1" parent="3"><mxGeometry x="832" y="58" width="160" height="72" as="geometry" /></mxCell><mxCell id="13" value="校验当前权限及城市&lt;br&gt;请求原业务系统启停" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef4ff;strokeColor=#a8bde8;fontColor=#24364c;fontSize=14;spacing=8;" vertex="1" parent="5"><mxGeometry x="1042" y="58" width="160" height="72" as="geometry" /></mxCell><mxCell id="14" value="按当前城市应用开关&lt;br&gt;返回实际生效结果" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef4ff;strokeColor=#a8bde8;fontColor=#24364c;fontSize=14;spacing=8;" vertex="1" parent="7"><mxGeometry x="1252" y="58" width="160" height="72" as="geometry" /></mxCell><mxCell id="15" value="确认生效：更新状态&lt;br&gt;失败 / 未确认：提示&lt;br&gt;并核实实际状态" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef4ff;strokeColor=#a8bde8;fontColor=#24364c;fontSize=14;spacing=8;" vertex="1" parent="5"><mxGeometry x="1462" y="58" width="160" height="72" as="geometry" /></mxCell><mxCell id="16" value="开启：处理后续事件&lt;br&gt;关闭：停止该规则&lt;br&gt;在当前城市新增触达" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef4ff;strokeColor=#a8bde8;fontColor=#24364c;fontSize=14;spacing=8;" vertex="1" parent="7"><mxGeometry x="1672" y="58" width="160" height="72" as="geometry" /></mxCell><mxCell id="17" value="注册信息" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#71849d;strokeWidth=1.5;fontSize=12;fontColor=#60728a;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="9" target="10"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="407" y="570" /><mxPoint x="407" y="382" /></Array></mxGeometry></mxCell><mxCell id="18" value="任务列表" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#71849d;strokeWidth=1.5;fontSize=12;fontColor=#60728a;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="10" target="11"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="617" y="382" /><mxPoint x="617" y="194" /></Array></mxGeometry></mxCell><mxCell id="19" value="管理员操作" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#71849d;strokeWidth=1.5;fontSize=12;fontColor=#60728a;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="11" target="12"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-52" as="offset" /><Array as="points"><mxPoint x="827" y="194" /><mxPoint x="827" y="194" /></Array></mxGeometry></mxCell><mxCell id="20" value="确认操作" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#71849d;strokeWidth=1.5;fontSize=12;fontColor=#60728a;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="12" target="13"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1037" y="194" /><mxPoint x="1037" y="382" /></Array></mxGeometry></mxCell><mxCell id="21" value="启停请求" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#71849d;strokeWidth=1.